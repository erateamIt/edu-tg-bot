# Telegram UserBot credentials
API_ID=12345678
API_HASH=your_api_hash
PHONE_NUMBER=+998901234567

# Admin Telegram ID for alerts and admin bot access
ADMIN_CHAT_ID=123456789
REPORT_USER_ID=0
REPORT_TIME=21:00
REPORT_TIMEZONE=Asia/Tashkent
BACKUP_USER_ID=0

# Telegram BotFather token for the separate admin/configuration bot
ADMIN_BOT_TOKEN=123456:YOUR_BOT_TOKEN
ADMIN_USER_ID=0
# Set a specific administrator ID in production; zero allows all users.

MONITOR_MINUTES=5
WELCOME_MESSAGE=

# Web panel
PANEL_HOST=127.0.0.1
PANEL_PORT=8000
PANEL_TOKEN=change-this-token

SESSION_NAME=education_center

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=education_center
DB_USER=education_user
DB_PASSWORD=change-this-password
